new file mode 100644
index 0000000..84ac595
--- /dev/null
+++ b/src/utils/html-to-markdown.ts
@@ -0,0 +1,90 @@
+/**
+ * PingCode 富文本（描述、多行文本属性、评论）转 Markdown。
+ * 只处理 PingCode 编辑器常见标签；图片替换为 [图N] 占位，并按出现顺序收集地址，
+ * 便于调用方下载原图后与占位一一对应。
+ */
+
+export interface HtmlImage {
+  /** 从 1 开始的全局序号，对应正文里的 [图N] */
+  index: number;
+  src: string;
+  alt: string;
+  /** PingCode 在 img 上标注的原图字节数 */
+  size?: number;
+}
+
+const ENTITIES: Record<string, string> = {
+  amp: '&',
+  lt: '<',
+  gt: '>',
+  quot: '"',
+  apos: "'",
+  nbsp: ' ',
+};
+
+function decodeEntities(text: string): string {
+  return text.replace(/&(#x[0-9a-f]+|#\d+|[a-z]+);/gi, (match, code: string) => {
+    if (code[0] === '#') {
+      const value = code[1] === 'x' || code[1] === 'X' ? parseInt(code.slice(2), 16) : parseInt(code.slice(1), 10);
+      return Number.isFinite(value) ? String.fromCodePoint(value) : match;
+    }
+    return ENTITIES[code.toLowerCase()] ?? match;
+  });
+}
+
+function getAttr(tag: string, name: string): string | undefined {
+  const match = tag.match(new RegExp(`\\s${name}\\s*=\\s*("([^"]*)"|'([^']*)'|([^\\s>]+))`, 'i'));
+  if (!match) return undefined;
+  return decodeEntities(match[2] ?? match[3] ?? match[4] ?? '');
+}
+
+/**
+ * @param html PingCode 返回的 HTML；纯文本也可以直接传入
+ * @param images 收集图片的数组，多段 HTML 共用同一个数组即可得到全局连续的 [图N]
+ */
+export function htmlToMarkdown(html: string | null | undefined, images: HtmlImage[] = []): string {
+  if (!html) return '';
+  if (!/<[a-z][\s\S]*>/i.test(html)) return decodeEntities(html).trim();
+
+  let text = html.replace(/\r\n?/g, '\n');
+
+  text = text.replace(/<img\b[^>]*>/gi, (tag) => {
+    const src = getAttr(tag, 'src');
+    if (!src) return '';
+    const sizeAttr = Number(getAttr(tag, 'size'));
+    const image: HtmlImage = {
+      index: images.length + 1,
+      src,
+      alt: getAttr(tag, 'alt') ?? '',
+      size: Number.isFinite(sizeAttr) && sizeAttr > 0 ? sizeAttr : undefined,
+    };
+    images.push(image);
+    return `\n[图${image.index}]\n`;
+  });
+
+  text = text
+    .replace(/<(script|style)\b[\s\S]*?<\/\1>/gi, '')
+    .replace(/<br\s*\/?>/gi, '\n')
+    .replace(/<h([1-6])\b[^>]*>/gi, (_m, level: string) => `\n\n${'#'.repeat(Number(level))} `)
+    .replace(/<\/h[1-6]>/gi, '\n\n')
+    .replace(/<li\b[^>]*>/gi, '\n- ')
+    .replace(/<\/(ul|ol)>/gi, '\n')
+    .replace(/<(strong|b)\b[^>]*>([\s\S]*?)<\/\1>/gi, '**$2**')
+    .replace(/<(em|i)\b[^>]*>([\s\S]*?)<\/\1>/gi, '*$2*')
+    .replace(/<code\b[^>]*>([\s\S]*?)<\/code>/gi, '`$1`')
+    .replace(/<a\b[^>]*href\s*=\s*"([^"]*)"[^>]*>([\s\S]*?)<\/a>/gi, (_m, href: string, label: string) => {
+      const plain = label.replace(/<[^>]+>/g, '').trim();
+      return plain && plain !== href ? `[${plain}](${href})` : href;
+    })
+    .replace(/<\/(td|th)>/gi, ' | ')
+    .replace(/<\/tr>/gi, '\n')
+    .replace(/<\/(p|div|blockquote|pre|table)>/gi, '\n\n')
+    .replace(/<[^>]+>/g, '');
+
+  return decodeEntities(text)
+    .split('\n')
+    .map((line) => line.replace(/[ \t]+$/g, ''))
+    .join('\n')
+    .replace(/\n{3,}/g, '\n\n')
+    .trim();
+}
